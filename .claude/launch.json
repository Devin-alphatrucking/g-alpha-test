{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dvn-haul",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "dvn-api",
      "runtimeExecutable": "C:/xampp/php/php.exe",
      "runtimeArgs": [
        "-S",
        "127.0.0.1:8099",
        "-t",
        "public"
      ],
      "port": 8099
    }
  ]
}
