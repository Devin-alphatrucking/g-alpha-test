# Production hardening, SEO hygiene and caching (copied into dist/ by the build)
Options -Indexes
ErrorDocument 404 /404.html

<FilesMatch "^(config\.php|\.env)$">
  Require all denied
</FilesMatch>

# One canonical address per page = no duplicate-content dilution.
# 1) Uncomment once the site has an HTTPS certificate:
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# 2) Pick ONE host (this example redirects www -> non-www; flip it if you prefer www):
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Hashed build assets never change: cache for a year. HTML must always revalidate so new releases show up.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(sitemap\.xml|robots\.txt|ads\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "^live\.php$">
    Header set Cache-Control "public, max-age=60"
  </FilesMatch>
</IfModule>
